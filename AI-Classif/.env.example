# Copy to .env and fill in your own values before starting the project.
# Do not commit .env or send it to anyone.
POSTGRES_DB=procurement
POSTGRES_USER=procurement
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_UNIQUE_STRONG_PASSWORD

# Internal Docker network settings (normally keep these defaults).
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/0

MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=INFO
MAX_DOCUMENT_UPLOAD_MB=100
MAX_DOCUMENT_PAGES=2000
